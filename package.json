    "bugs": "https://github.com/TheoLeCalvar/peertube-plugin-hardware-transcode-vaapi",
    "library": "./dist/main.js",
    "files": [
        "/dist"
    ],
    "staticDirs": {},
    "css": [],
    "clientScripts": [],
    "translations": {},
    "scripts": {
        "clean": "rm -rf dist/*",
